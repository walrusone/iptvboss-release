# The image name is separate from its tag so a future release channel can be
# selected without editing compose.yaml.
IPTVBOSS_IMAGE=ghcr.io/walrusone/iptvboss-release
IPTVBOSS_TAG=latest

# The standalone setup publishes unencrypted HTTP on the host's network
# interfaces. It is suitable for a trusted LAN, but must not be forwarded to
# the Internet. Set this to 127.0.0.1 when using a proxy on this host.
IPTVBOSS_HOST_IP=0.0.0.0
IPTVBOSS_HOST_PORT=8001
IPTVBOSS_XC_PORT=8001

# Set proxy mode to true only when Caddy or another HTTPS reverse proxy is in
# front of IPTVBoss. The proxy must supply X-Forwarded-Proto: https.
IPTVBOSS_XC_BEHIND_HTTPS_PROXY=false
IPTVBOSS_HTTPS_ONLY=false
IPTVBOSS_XC_BIND_ADDRESS=all

# Used only for direct HTTPS with /data/keystore.p12. Leave empty in proxy mode.
IPTVBOSS_XC_KEYSTORE_PASSWORD=

# Leave empty for standalone use or a trusted same-host proxy.
IPTVBOSS_XC_TRUSTED_PROXIES=

# The container runs without root privileges. Most installations should keep
# these defaults.
IPTVBOSS_UID=10001
IPTVBOSS_GID=10001
